---
import { posters } from "../lib/posters.js";
import "../styles/global.css";
const postersSorted = [...posters].sort((a, b) => b.no - a.no); // ✅ 기본: 내림차순
---


<main class="page">
  <header class="header">
    <h1 id="pageTitle">OneDayOnePoster</h1>
    <p class="sub">The ODOP Project—short for OneDayOnePoster—is a daily poster-making practice by JEBI, a design student completing military service. Starting on August 15, 2025, the project continues through February 12, 2026, culminating on the day of discharge.
    </p>

   <div class="actions">
    <button class="btn" type="button" data-sort="no">Order</button>
   <button class="btn" type="button" data-action="shuffle">Shuffle</button>
</div>

  </header>

  <section class="grid" aria-label="poster grid">
 {postersSorted.map((p) => (
  <article class="card" data-poster-id={p.id} data-no={p.no} data-date={p.date}>
    <a class="cardLink" href={`/odop/${p.no3}`}>
      <div class="thumb">
        <img
          src={p.thumb}
          alt={p.title}
          loading="lazy"
          width="600"
          height="850"
        />
      </div>
    </a>

    <div class="meta">
      <time class="date" datetime={p.date}>{p.date}</time>
      <h2 class="title">{p.title}</h2>
    </div>
  </article>
))}

  </section>
</main>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    
    const grid = document.querySelector(".grid");
    if (!grid) return;

    const shuffleBtn = document.querySelector('[data-action="shuffle"]');
    const sortNoBtn = document.querySelector('[data-sort="no"]');

    function shuffleInPlace(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
        
      }
    }

    function resort(compareFn) {
      const cards = Array.from(grid.children);
      cards.sort(compareFn);
      cards.forEach((c) => grid.appendChild(c));
    }

    shuffleBtn?.addEventListener("click", () => {
      const cards = Array.from(grid.children);
      shuffleInPlace(cards);
      cards.forEach((c) => grid.appendChild(c));
    });

  let noAsc = false; // ✅ 기본: 내림차순(false)

sortNoBtn?.addEventListener("click", () => {
  // 토글
  noAsc = !noAsc;

  resort((a, b) => {
    const A = Number(a.dataset.no);
    const B = Number(b.dataset.no);
    return noAsc ? A - B : B - A;
  });

  // (선택) 버튼 라벨 표시
  //sortNoBtn.textContent = noAsc ? "No ↑" : "No ↓";
});



  });
</script>




<style>
  .page {
  padding: 30px;
  font-family: system-ui,-helvetica, -apple-system, pretendards, sans-serif;
  max-width: 1200px;
  margin: 0 auto;
}


  .header {
    margin-bottom: 24px;
  }

.sub {
  margin-top: 16;
  color: rgba(249, 249, 249, 0.72);
   max-width: 88ch;   /* ✅ 한 줄 길이 제한(글자폭 기준) */
}

.date {
  font-size: 12px;
  color: rgba(249, 249, 249, 0.6);
}


  .actions {
    margin-top: 16px;
    display: flex;
    gap: 8px;
    margin-bottom: 28px;
  }

  .btn {
  padding: 10px 12px;
  border: 1px solid rgba(249, 249, 249, 0.22);
  font-size: var(--ui-font-size);
  border-radius: 5px; /* ✅ 둥근 모서리 제거 */
  background: transparent;
  color: #00FFAA;     /* ✅ 버튼 글자색 */
  cursor: pointer;
}


 .grid {
  display: grid;
  gap: 12px;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  align-items: start;
}


  .card {
  border: 0px solid rgba(249, 249, 249, 0.12);
  border-radius: 5px; /* ✅ 둥근 모서리 제거 */
  overflow: hidden;
  background: transparent;
}

.thumb {
  height: 260px;         /* 그리드에서 썸네일 높이 통일 */
  overflow: hidden;
  background: rgba(0, 0, 0, 0.06);
}

.thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;     /* 꽉 채우되 넘치면 잘림 */
  display: block;
}

  .meta {
    padding: 6px 12px;
  }

  .date {
    font-size: 12px;
    opacity: 0.7;
  }

  .title {
    margin: 0px 0 0;
    font-size: 14px;
    font-weight: 600;
  }
  :global(body) {
  margin: 0;
  background: #181818;
  color: #f9f9f9;
}

:global(*) {
  box-sizing: border-box;
}
.cardLink {
  display: block;
  color: inherit;
  text-decoration: none;
}
/* 썸네일 인터랙션 */
.card .thumb img {
  transition:
    transform 0.25s ease,
    filter 0.25s ease;
}

.card:hover .thumb img {
  transform: scale(0.96);        /* 살짝 작아짐 */
  filter: brightness(0.75);      /* 명도 낮아짐 */
}
.card:hover {
  cursor: pointer;
  }

  .card .title {
  transition: color 0.25s ease;
}

.card:hover .title {
  color: #00ffaa; /* 포인트 컬러 */
}

</style>