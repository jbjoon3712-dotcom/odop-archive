---
import { posters } from "../../lib/posters.js";
import { getEntry } from "astro:content";
import "../../styles/global.css";

export function getStaticPaths() {
  return posters.map((p, idx) => ({
    params: { no: p.no3 },
    props: {
      p,
      prev: posters[idx - 1] ?? null,
      next: posters[idx + 1] ?? null,
    },
  }));
}

const { p, prev, next } = Astro.props;
const { no } = Astro.params;

const key = no; // padStart 불필요

const entry = await getEntry("odop", no);
if (!entry) {
  return new Response("Not found", { status: 404 });
}

const { Content } = await entry.render();
const data = entry.data;  // ✅ 여기! render()가 아니라 entry.data



---


<main class="detail">
  <header class="top">
    <div class="topRow">
      <a class="back" href="/"><span aria-hidden="true">←</span> Back</a>

      <nav class="nav">
        {prev ? <a class="btn" data-nav="prev" href={`/odop/${prev.no3}`}>Prev</a> : <span class="btn disabled">Prev</span>}
        {next ? <a class="btn" data-nav="next" href={`/odop/${next.no3}`}>Next</a> : <span class="btn disabled">Next</span>}
      </nav>
    </div>

    <div class="meta">
      <div class="no">{p.title}</div>
      <time class="date" datetime={p.date}>{p.date}</time>
    </div>

    <div class="info">
      <div class="line">
        <span class="tag">[One Day One Poster]</span>
        <span class="dot">•</span>
        <span class="day">Day {data.day ?? no}</span>
      </div>

      {data.subject && (
        <div class="row">
          <span class="k">Subject</span>
          <span class="v">{data.subject}</span>
        </div>
      )}

      {Array.isArray(data.tools) && data.tools.length > 0 && (
        <div class="row">
          <span class="k">Tools</span>
          <span class="v">{data.tools.join(", ")}</span>
        </div>
      )}

      {Array.isArray(data.fonts) && data.fonts.length > 0 && (
        <div class="row">
          <span class="k">Fonts</span>
          <span class="v">{data.fonts.join(", ")}</span>
        </div>
      )}
    </div>

    {p.desc && <p class="desc">{p.desc}</p>}
  </header>

  <section class="viewer">
    <div class="stage">
  <button class="posterBtn" type="button" data-zoom-open aria-label="Open fullscreen view">
    <img class="poster" src={p.img} alt={p.title} />
  </button>
</div>

  </section>

  <section class="note">
    {Content ? <Content /> : <p class="missing">행복합시다.</p>}

  </section>
  <div class="zoom" data-zoom hidden>

  <img class="zoomImg" data-zoom-img alt="" />
</div>

</main>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const zoom = document.querySelector("[data-zoom]");
    const zoomImg = document.querySelector("[data-zoom-img]");
    const openBtn = document.querySelector("[data-zoom-open]");
  

    function openZoom() {
      if (!openBtn || !zoom || !zoomImg) return;
      const img = openBtn.querySelector("img");
      if (!img) return;

      zoomImg.src = img.currentSrc || img.src;
      zoomImg.alt = img.alt || "Poster";

      zoom.hidden = false;
      document.body.classList.add("zoomOpen");
    }

    function closeZoom() {
      if (!zoom) return;
      zoom.hidden = true;
      document.body.classList.remove("zoomOpen");
      if (zoomImg) zoomImg.src = "";
    }

    openBtn?.addEventListener("click", openZoom);

    zoom?.addEventListener("click", (e) => {
      if (e.target === zoom) closeZoom();
    });

    // ✅ 키보드 핸들링을 "상태 분기"로 정리
    document.addEventListener("keydown", (e) => {
      const zoomOpen = zoom && !zoom.hidden;

      if (e.key === "Escape") {
        if (zoomOpen) {
          e.preventDefault();
          closeZoom();
        } else {
          window.location.href = "/";
        }
      }

      if (!zoomOpen && e.key === "ArrowLeft") {
        document.querySelector('[data-nav="prev"]')?.click();
      }

      if (!zoomOpen && e.key === "ArrowRight") {
        document.querySelector('[data-nav="next"]')?.click();
      }
    });
    const params = new URLSearchParams(window.location.search);
    const shouldOpenZoom = params.get("zoom") === "1";
    if (shouldOpenZoom) openZoom();

    function withZoomParam(href) {
    const url = new URL(href, window.location.origin);
   url.searchParams.set("zoom", "1");
   return url.pathname + url.search;
    }

    function withoutZoomParam(href) {
   const url = new URL(href, window.location.origin);
   url.searchParams.delete("zoom");
   return url.pathname + url.search;
   }

   const prevLink = document.querySelector('[data-nav="prev"]');
   const nextLink = document.querySelector('[data-nav="next"]');

   prevLink?.addEventListener("click", (e) => {
    if (zoom && !zoom.hidden) {
    e.preventDefault();
    window.location.href = withZoomParam(prevLink.href);
  }
});

nextLink?.addEventListener("click", (e) => {
  if (zoom && !zoom.hidden) {
    e.preventDefault();
    window.location.href = withZoomParam(nextLink.href);
  }
});

  });
  
</script>


<style>
  :global(body) {
    margin: 0;
    background: #090909;
    color: #f9f9f9;
  }

  .detail {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
  }

  .top {
    display: grid;
    gap: 16px;
    margin-bottom: 16px;
  }

  .topRow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .back {
     display: inline-flex;
  align-items: center;
  gap: 6px;

  padding: 10px 7px;
 font-size: var(--ui-font-size);
  border: 1px solid rgba(255,255,255,0.22);
  border-radius:4px;

  color: #f9f9f9;
  text-decoration: none;

  transition: transform 160ms ease,
              filter 160ms ease,
              border-color 160ms ease,
              background 160ms ease;
  }

  .nav {
    display: flex;
    gap: 8px;
  }

  .btn {
    border: 1px solid rgba(249, 249, 249, 0.22);
    padding: 10px 12px;
    font-size: var(--ui-font-size);
    border-radius: 4px;
    background: transparent;
    color: #f9f9f9;
    text-decoration: none;
    display: inline-block;
  }

  .btn.disabled {
    opacity: 0.35;
    pointer-events: none;
  }

  .meta {
    display: grid;
    gap: 6px;
  }

  .no {
    font-weight: 700;
    font-size: 32px;
    letter-spacing: -0.02em;
    margin-left: 12px;
  }

  .date {
    color: rgba(249, 249, 249, 0.6);
    font-size: 14px;
    letter-spacing: 0.01em;
    margin-left: 12px;
  }

  /* ✅ 정보( day/subject/tools/fonts ) 타이포 조절 */
  .info {
    display: grid;
    gap: 4px;
    max-width: 100ch;
    margin-top: 12px;
    margin-left: 12px;
  }

  .line {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 14px;
    line-height: 1.6;
    letter-spacing: 0.01em;
  }

  .tag {
    color: rgba(249, 249, 249, 0.72);
  }

  .day {
    font-weight: 600;
  }

  .row {
    display: flex;
    gap: 12px;
    font-size: 14px;
    line-height: 1.7;
    letter-spacing: 0.01em;
  }

  .k {
    min-width: 72px;
    opacity: 0.6;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: auto;
  }

  .v {
    opacity: 0.9;
  }

  .desc {
    margin: 10px 0 0;
    max-width: 100ch;
    line-height: 1.7;
    letter-spacing: 0.01em;
    color: rgba(249, 249, 249, 0.78);
    font-size: 14px;
  }

  .viewer {
    border: 0;
    padding: 12px 0 0;
  }

  .stage {
    border: 0px solid rgba(249, 249, 249, 0.12);
    background: #090909;
    padding: 10px;
  }

  .poster {
    width: 100%;
    height: auto;
    height: auto;
    display: block;
  }

  /* ✅ Note(마크다운 본문) 타이포/행간/마진 */
  .note {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid rgba(249, 249, 249, 0.12);
    max-width: 100ch;
  }

  .note :global(p) {
    margin: 0 0 12px;
    line-height: 1.8;
    letter-spacing: 0.01em;
    font-size: 16px;
  }

  .note :global(h1),
  .note :global(h2),
  .note :global(h3) {
    margin: 18px 0 10px;
    letter-spacing: -0.01em;
  }

  .note :global(ul),
  .note :global(ol) {
    margin: 0 0 12px;
    padding-left: 18px;
    line-height: 1.8;
    font-size: 16px;
  }

  .missing {
    opacity: 0.6;
    margin: 0;
  }


}

.closeBtn:hover {
  background: rgba(255,255,255,0.06);
}

.zoomImg {
  max-width: None;
  max-height: 92vh;
  object-fit: contain;

  border: 1px solid rgba(255,255,255,0.25);
  box-shadow: 0 0 0 1px rgba(255,255,255,0.05);
}

/* zoom 오버레이 */
.zoom {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.72);
  display: grid;
  place-items: center;
  z-index: 1000;
}

/* nav를 zoom보다 위로 */
.nav {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 1100;
}


if (e.key === "ArrowLeft") {
  document.querySelector('[data-nav="prev"]')?.click();
}
if (e.key === "ArrowRight") {
  document.querySelector('[data-nav="next"]')?.click();
}

/* ✅ hidden이면 무조건 안 보이게 (가장 중요) */
.zoom[hidden] {
  display: none !important;
}

/* ✅ 줌 오버레이 기본 스타일 */
.zoom {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0,0,0,0.72);
  display: grid;
  place-items: center;
  padding: 24px;.zoom 
  pointer-events: none;
}

/* ✅ Prev/Next는 줌 위로 */
.nav {
  position: fixed;
  top: 24px;
  right: 24px;
  z-index: 1100;
}
.back:hover {
  transform: scale(0.96);
  filter: brightness(0.85);
}

.back:active {
  transform: scale(0.94);
  filter: brightness(0.75);
  /* active(클릭 순간) 더 강하게 */
  color: #00FFAA;
  transform: scale(0.95);
}
}
.back:focus-visible {
  outline: 2px solid rgba(255,255,255,0.35);
  outline-offset: 3px;
}

/* ✅ Prev/Next (그리고 btn 전부) 인터랙션 */
.btn {
  transition: transform 160ms ease, filter 160ms ease, opacity 160ms ease, border-color 160ms ease, background 160ms ease;
  transform-origin: center;
  will-change: transform, filter;
}

.btn:hover {
  transform: scale(0.96);
  filter: brightness(0.85);
}

.btn:active {
  transform: scale(0.94);
  filter: brightness(0.75);
}

.btn:focus-visible {
  outline: 2px solid rgba(255,255,255,0.35);
  outline-offset: 3px;
}

/* 비활성(Prev/Next 없는 경우)에서는 hover/active가 안 먹게 */
.btn.disabled,
.btn:disabled {
  transform: none !important;
  filter: none !important;
  opacity: 0.35;
  cursor: not-allowed;
}
.btn {
  transition: 
    transform 160ms ease,
    filter 160ms ease,
    color 180ms ease,
    border-color 180ms ease;
}

/* active(클릭 순간) 더 강하게 */
.btn:active {
  color: #00FFAA;
  transform: scale(0.95);
}


</style>
